{
  "info": {
    "name": "tt-apps API",
    "description": "Internal platform API — ibrastudio. Base URL: {{base_url}}/api/v1\n\nAuthentication: Bearer token. Obtain via POST /auth/login, then set {{api_token}} environment variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080", "type": "string" },
    { "key": "api_token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"securepassword123\"\n}"
            }
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"success\",\n  \"data\": {\n    \"token\": \"<bearer_token>\",\n    \"expires_at\": \"2024-12-31T23:59:59Z\",\n    \"user\": {\n      \"id\": 1,\n      \"name\": \"Administrator\",\n      \"email\": \"admin@example.com\"\n    }\n  }\n}"
            },
            {
              "name": "401 Unauthorized",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"status\": \"error\",\n  \"message\": \"Invalid credentials\"\n}"
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{api_token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/auth/logout", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "logout"] }
          },
          "response": [
            {
              "name": "204 No Content",
              "status": "No Content",
              "code": 204,
              "body": ""
            }
          ]
        }
      ]
    },
    {
      "name": "Core — Users",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{api_token}}" }],
            "url": {
              "raw": "{{base_url}}/api/v1/users?page=1&per_page=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "20" }
              ]
            }
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"success\",\n  \"data\": [\n    { \"id\": 1, \"name\": \"Administrator\", \"email\": \"admin@example.com\", \"status\": \"active\" }\n  ],\n  \"meta\": { \"total\": 1, \"page\": 1, \"per_page\": 20, \"last_page\": 1 }\n}"
            }
          ]
        },
        {
          "name": "Get User",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{api_token}}" }],
            "url": { "raw": "{{base_url}}/api/v1/users/1", "host": ["{{base_url}}"], "path": ["api", "v1", "users", "1"] }
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"success\",\n  \"data\": { \"id\": 1, \"name\": \"Administrator\", \"email\": \"admin@example.com\", \"status\": \"active\", \"roles\": [\"SuperAdmin\"] }\n}"
            }
          ]
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{api_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/users", "host": ["{{base_url}}"], "path": ["api", "v1", "users"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@ibrastudio.com\",\n  \"password\": \"password123\",\n  \"role_ids\": [1]\n}"
            }
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"status\": \"success\",\n  \"data\": { \"id\": 2, \"name\": \"Jane Doe\", \"email\": \"jane@ibrastudio.com\", \"status\": \"active\" }\n}"
            },
            {
              "name": "422 Validation Error",
              "status": "Unprocessable Entity",
              "code": 422,
              "body": "{\n  \"status\": \"error\",\n  \"message\": \"Validation failed\",\n  \"errors\": { \"email\": \"The email field must be unique.\" }\n}"
            }
          ]
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{api_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/users/2", "host": ["{{base_url}}"], "path": ["api", "v1", "users", "2"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Jane Smith\",\n  \"status\": \"inactive\"\n}" }
          },
          "response": [
            { "name": "200 OK", "status": "OK", "code": 200, "body": "{\n  \"status\": \"success\",\n  \"data\": { \"id\": 2, \"name\": \"Jane Smith\", \"status\": \"inactive\" }\n}" }
          ]
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{api_token}}" }],
            "url": { "raw": "{{base_url}}/api/v1/users/2", "host": ["{{base_url}}"], "path": ["api", "v1", "users", "2"] }
          },
          "response": [
            { "name": "204 No Content", "status": "No Content", "code": 204, "body": "" }
          ]
        }
      ]
    },
